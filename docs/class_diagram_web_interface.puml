@startuml
!include style.iuml
title Class diagram - Web Interface

class WasteUploadView {
  - selected_image : FileStorage
  - image_name : str
  - image_size : int
  - image_type : str
  - upload_status : str
  - max_size_bytes : int
  - error_message : str
  --
  + __init__(max_size_bytes : int = 10 MB)
  + initialize() : None
  + to_dict() : dict
  + select_image(image : FileStorage) : FileStorage
  + submit_image() : bool
}

class AnalysisController {
  - request_status : str
  - error_message : str
  - allowed_extensions : tuple
  --
  + __init__(allowed_extensions : tuple = None)
  + initialize(allowed_extensions : tuple = None) : None
  + to_dict() : dict
  + validate_upload(image : bytes, filename : str) : bool
  + request_analysis(image : bytes, filename : str) : dict
  + handle_error(error_message : str) : None
}

class ClassificationResultView {
  - waste_name : str
  - category : WasteCategory
  - confidence : float
  - disposal_instruction : str
  - explanation : str
  - error_message : str
  --
  + __init__()
  + initialize() : None
  + to_dict() : dict
  + display_result(result : dict) : dict
  + display_error(message : str) : dict
}

class WasteCategory <<support>> {
  RECYCLABLE
  COMPOSTABLE
  LANDFILL
}

package "exceptions.py" <<Rectangle>> {
  class WebInterfaceError <<error>> {
    + message : str
  }
  class InvalidUploadError <<error>>
  class InvalidResultError <<error>>
  class ImageRejectedError <<error>>
}

WasteUploadView "1" -right- "1" AnalysisController : submits
AnalysisController "1" -right- "0..1" ClassificationResultView : returns result
ClassificationResultView -right-> "1" WasteCategory : category

WebInterfaceError <|-- InvalidUploadError
WebInterfaceError <|-- InvalidResultError
WebInterfaceError <|-- ImageRejectedError

WasteUploadView -[hidden]down- WebInterfaceError
AnalysisController ..> WebInterfaceError : raises\n(InvalidUploadError)
WasteUploadView ..> WebInterfaceError : raises\n(InvalidUploadError)
ClassificationResultView ..> WebInterfaceError : raises\n(InvalidResultError)

note as N1
  All getters and setters validate input.
  InvalidUploadError, InvalidResultError and
  ImageRejectedError are also ValueErrors.
end note
InvalidResultError -[hidden]right- N1
@enduml
