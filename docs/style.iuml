skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0
skinparam nodesep 60
skinparam ranksep 60
hide circle
hide stereotype
hide empty methods
hide empty fields
skinparam title {
  FontColor #6B2D6B
  FontSize 22
  FontStyle bold
}
skinparam class {
  BackgroundColor #FFFFFF
  HeaderBackgroundColor #6B2D6B
  BorderColor #6B2D6B
  BorderThickness 1.5
  FontColor #FFFFFF
  FontStyle bold
  FontSize 15
  AttributeFontColor #1A1A1A
  AttributeFontStyle bold
  AttributeFontSize 13
  ArrowColor #333333
}
skinparam class<<support>> {
  HeaderBackgroundColor #4A4A4A
  BorderColor #4A4A4A
}
skinparam class<<error>> {
  HeaderBackgroundColor #A23B3B
  BorderColor #A23B3B
}
skinparam class<<external>> {
  HeaderBackgroundColor #7A7A7A
  BorderColor #7A7A7A
}
