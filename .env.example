# Copy this file to .env and fill in your values. Never commit .env!
DB_PATH=database/waste.db

# AI (OpenAI or any OpenAI-compatible provider)
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=gpt-4o-mini
AI_DAILY_LIMIT=200
AI_MAX_TOKENS=1500
AI_TIMEOUT=8

