# Copy this file to .env and fill in your values. Never commit .env!
DB_ENGINE=sqlite
DB_PATH=database/waste.db

# Only for DB_ENGINE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=[your password]
DB_NAME=waste_db

# AI (OpenAI or any OpenAI-compatible provider)
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=gpt-4o-mini
AI_DAILY_LIMIT=200
AI_MAX_TOKENS=1500
AI_TIMEOUT=8

# Free option: Google Gemini (key from aistudio.google.com)
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_MODEL=gemini-3.5-flash-lite
